% texmf.cnf for tex.wasm — a fixed layout inside the Emscripten filesystem.
% Everything lives under /texmf; there is no SELFAUTO* discovery. Memory
% parameters mirror TeX Live 2025's defaults so formats built here behave like
% the oracle's.
TEXMFROOT = /texmf
TEXMFDIST = /texmf
TEXMFLOCAL = /texmf-local
TEXMFVAR = /texmf-var
TEXMFCONFIG = /texmf-var
TEXMFSYSVAR = /texmf-var
TEXMFSYSCONFIG = /texmf-var
TEXMFHOME = /home/texmf
TEXMF = {$TEXMFVAR,$TEXMFHOME,!!$TEXMFLOCAL,!!$TEXMFDIST}
TEXMFDBS = {!!$TEXMFLOCAL,!!$TEXMFDIST}
SYSTEXMF = $TEXMFLOCAL;$TEXMFDIST
TEXMFDOTDIR = .
WEB2C = $TEXMF/web2c
TEXINPUTS.tex     = $TEXMFDOTDIR;$TEXMF/tex/{plain,generic,latex,}//
TEXINPUTS.etex    = $TEXMFDOTDIR;$TEXMF/tex/{plain,generic,latex,}//
TEXINPUTS.pdftex  = $TEXMFDOTDIR;$TEXMF/tex/{plain,generic,latex,}//
TEXINPUTS.latex   = $TEXMFDOTDIR;$TEXMF/tex/{latex,generic,}//
TEXINPUTS.pdflatex= $TEXMFDOTDIR;$TEXMF/tex/{latex,generic,}//
TEXINPUTS         = $TEXMFDOTDIR;$TEXMF/tex/{$progname,generic,}//
% LuaTeX (DVI mode): TeX and Lua inputs per program name, as in TeX Live
TEXINPUTS.luatex      = $TEXMFDOTDIR;$TEXMF/tex/{luatex,plain,generic,latex,}//
TEXINPUTS.dviluatex   = $TEXMFDOTDIR;$TEXMF/tex/{luatex,plain,generic,latex,}//
TEXINPUTS.lualatex    = $TEXMFDOTDIR;$TEXMF/tex/{lualatex,latex,luatex,generic,}//
TEXINPUTS.dvilualatex = $TEXMFDOTDIR;$TEXMF/tex/{lualatex,latex,luatex,generic,}//
LUAINPUTS.lualatex    = $TEXMFDOTDIR;$TEXMF/scripts/{$progname,$engine,}/{lua,}//;$TEXMF/tex/{lualatex,latex,luatex,generic,}//
LUAINPUTS.dvilualatex = $TEXMFDOTDIR;$TEXMF/scripts/{$progname,$engine,}/{lua,}//;$TEXMF/tex/{lualatex,latex,luatex,generic,}//
LUAINPUTS             = $TEXMFDOTDIR;$TEXMF/scripts/{$progname,$engine,}/{lua,}//;$TEXMF/tex/{luatex,plain,generic,latex,}//
CLUAINPUTS            = $TEXMFDOTDIR
TEXFORMATS = $TEXMFDOTDIR;$TEXMF/web2c
TEXPOOL    = $TEXMFDOTDIR;$TEXMF/web2c
TFMFONTS   = $TEXMFDOTDIR;$TEXMF/fonts/tfm//
VFFONTS    = $TEXMFDOTDIR;$TEXMF/fonts/vf//
TEXFONTMAPS= $TEXMFDOTDIR;$TEXMF/fonts/map//
ENCFONTS   = $TEXMFDOTDIR;$TEXMF/fonts/enc//
T1FONTS    = $TEXMFDOTDIR;$TEXMF/fonts/type1//
AFMFONTS   = $TEXMFDOTDIR;$TEXMF/fonts/afm//
TTFONTS    = $TEXMFDOTDIR;$TEXMF/fonts/truetype//
OPENTYPEFONTS = $TEXMFDOTDIR;$TEXMF/fonts/opentype//
TEXPSHEADERS = $TEXMFDOTDIR;$TEXMF/{dvips,fonts/{enc,type1,type42,type3}}//
PKFONTS = $TEXMFDOTDIR;$TEXMF/fonts/pk//
MISCFONTS = $TEXMFDOTDIR;$TEXMF/fonts/misc//
TEXCONFIG = $TEXMF/dvips//
TEXSOURCES = $TEXMFDOTDIR;$TEXMF/source//
TEXFONTS = $TEXMFDOTDIR;$TEXMF/fonts//
MFINPUTS = $TEXMFDOTDIR;$TEXMF/metafont//
MPINPUTS = $TEXMFDOTDIR;$TEXMF/metapost//
TEXMFINI = $TEXMFDOTDIR;$TEXMF/tex/generic/config//;$TEXMF/tex/{plain,generic,latex}//
TEXMFSCRIPTS = $TEXMF/scripts/{$progname,$engine,}//
% never try to spawn mktex* helpers (there are no subprocesses in wasm)
MKTEXTEX = 0
MKTEXPK = 0
MKTEXTFM = 0
MKTEXMF = 0
MKTEXFMT = 0
MKOCP = 0
MKOFM = 0
% security: no shell escape, ever
shell_escape = f
shell_escape.tex = f
shell_escape.initex = f
openin_any = a
openout_any = p
parse_first_line = t
parse_first_line.tex = f
parse_first_line.initex = f
file_line_error_style = f
texmf_casefold_search = 1
% memory (TeX Live 2025 defaults)
main_memory = 5000000
extra_mem_top = 0
extra_mem_bot = 0
font_mem_size = 8000000
font_max = 9000
hash_extra = 600000
pool_size = 6250000
string_vacancies = 90000
max_strings = 500000
pool_free = 47500
strings_free = 100
buf_size = 200000
trie_size = 1100000
hyph_size = 8191
nest_size = 1000
max_in_open = 15
param_size = 20000
save_size = 200000
stack_size = 10000
dvi_buf_size = 16384
error_line = 79
half_error_line = 50
max_print_line = 79
expand_depth = 10000
obj_tab_size = 1000
pdf_mem_size = 10000
dest_names_size = 131072
pk_bin_files = 0
