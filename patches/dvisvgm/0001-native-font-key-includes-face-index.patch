+	oss << path << "i" << fontIndex << "b" << style.bold << "e" << style.extend << "s" << style.slant;
 	auto it = ids.find(oss.str());
 	int id = ids.size();
 	if (it == ids.end())
@@ -600,7 +601,7 @@
 
 
 string NativeFont::name () const {
-	return uniqueName(path(), _style);
+	return uniqueName(path(), fontIndex(), _style);
 }
 
 
