+@ Every \&{shipout} stores four value nodes (the \&{charwd}, \&{charht},
+\&{chardp} and \&{charic} of the figure) in |tfm_width|, |tfm_height|,
+|tfm_depth| and |tfm_ital_corr|. Upstream never frees them: the loop in the
+deallocation code is commented out because after the \.{TFM} massaging the
+arrays point into the shared |dimen_head| lists (and at |zero_val|), so
+freeing them entry by entry double-frees. Freeing each distinct pointer once,
+and leaving |zero_val| and |inf_val| alone, is right in both states.
+(MetaPost-WASM patch 0012.)
+
+@<Declarations@>=
+static void mp_release_tfm_dimensions (MP mp);
+
+@ @c
+static int mp_compare_node_pointers (const void *a, const void *b) {
+  uintptr_t x = (uintptr_t) *(const mp_node *) a;
+  uintptr_t y = (uintptr_t) *(const mp_node *) b;
+  return (x < y) ? -1 : (x > y);
+}
+static void mp_release_tfm_dimensions (MP mp) {
+  mp_node *all = mp_xmalloc (mp, 4 * TFM_ITEMS, sizeof (mp_node));
+  int n = 0, k;
+  for (k = 0; k < TFM_ITEMS; k++) {
+    if (mp->tfm_width[k] != NULL)     { all[n++] = mp->tfm_width[k];     mp->tfm_width[k] = NULL; }
+    if (mp->tfm_height[k] != NULL)    { all[n++] = mp->tfm_height[k];    mp->tfm_height[k] = NULL; }
+    if (mp->tfm_depth[k] != NULL)     { all[n++] = mp->tfm_depth[k];     mp->tfm_depth[k] = NULL; }
+    if (mp->tfm_ital_corr[k] != NULL) { all[n++] = mp->tfm_ital_corr[k]; mp->tfm_ital_corr[k] = NULL; }
+  }
+  qsort (all, (size_t) n, sizeof (mp_node), mp_compare_node_pointers);
+  for (k = 0; k < n; k++) {
+    if ((k > 0 && all[k] == all[k - 1]) || all[k] == mp->zero_val || all[k] == mp->inf_val)
+      continue;
+    mp_free_value_node (mp, all[k]);
+  }
+  mp_xfree (all);
+  for (k = 1; k <= 4; k++)
+    mp->dimen_head[k] = NULL;
+}
+
